# App
SECRET_KEY=troque-para-um-valor-grande-e-aleatorio
SECURITY_PASSWORD_SALT=troque-para-outro-valor-grande-e-aleatorio
APP_TIMEZONE=America/Sao_Paulo
FLASK_DEBUG=False
AUTO_MIGRATE_ON_STARTUP=True

# Cache
CACHE_TYPE=FileSystemCache
CACHE_DEFAULT_TIMEOUT=3600
CACHE_THRESHOLD=500

# Registration and access control
MANAGEMENT_SECRET_CODE=GESTAO123
OPERATOR_SECRET_CODE=OPERADOR123

# Mail and outbound notifications
ENABLE_OUTBOUND_EMAIL=False
SECURITY_CONFIRMABLE=False
SECURITY_SEND_REGISTER_EMAIL=False
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Railway database references
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_WAIT_TIMEOUT=90
