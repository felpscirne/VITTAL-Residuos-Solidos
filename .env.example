# App security
SECRET_KEY=change-me
SECURITY_PASSWORD_SALT=change-me
AUTO_MIGRATE_ON_STARTUP=True

# Database (local execution)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projeto

# Timezone and database pool
APP_TIMEZONE=America/Sao_Paulo
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30

# Cache
CACHE_TYPE=FileSystemCache
CACHE_DEFAULT_TIMEOUT=3600
CACHE_THRESHOLD=500

# Registration and access control
MANAGEMENT_SECRET_CODE=GESTAO123
OPERATOR_SECRET_CODE=OPERADOR123
SUPERADMIN_NAME=Super Administrador
SUPERADMIN_EMAIL=admin@sistema.com
SUPERADMIN_PASSWORD=change-me

# Mail and outbound notifications (optional)
ENABLE_OUTBOUND_EMAIL=False
SECURITY_CONFIRMABLE=False
SECURITY_SEND_REGISTER_EMAIL=False
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
